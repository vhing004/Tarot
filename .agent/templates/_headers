# Cloudflare Pages: đặt tại public/_headers (R06 §5, R03 §7)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Asset Vite có hash trong tên file: cache lâu
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Model/texture/audio: đổi nội dung thì đổi tên file (kèm hash/phiên bản) để cache immutable an toàn
/models/*
  Cache-Control: public, max-age=31536000, immutable
/textures/*
  Cache-Control: public, max-age=31536000, immutable
/audio/*
  Cache-Control: public, max-age=31536000, immutable
/draco/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: luôn kiểm bản mới
/index.html
  Cache-Control: no-cache
